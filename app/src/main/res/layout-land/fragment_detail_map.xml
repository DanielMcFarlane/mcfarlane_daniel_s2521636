<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.cardview.widget.CardView
        android:id="@+id/mapCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white"
        app:cardUseCompatPadding="false"
        app:contentPadding="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.gms.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Fixed-Size Floating Satellite Pill Switcher in Top-Right (clears status bar / camera cutout) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mapTypeToggleCard"
                android:layout_width="96dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="38dp"
                android:layout_marginEnd="36dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#F2FFFFFF"
                app:cardCornerRadius="17dp"
                app:cardElevation="6dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/mapTypeIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Toggle Map View"
                        android:src="@drawable/ic_map_layers"
                        app:tint="@color/traffic_blue" />

                    <TextView
                        android:id="@+id/mapTypeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Satellite"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>