<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Header section -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/traffic_blue"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Traffic Scotland"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/refreshButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="@color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Connecting to live feed..."
            android:textColor="#BBDEFB"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Search and distance filter inputs -->
    <LinearLayout
        android:id="@+id/filterSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topHeader"
        android:background="@color/white"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="10dp">

        <EditText
            android:id="@+id/roadSearchInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:background="@drawable/search_bg"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:drawableTint="#888888"
            android:hint="Search road (e.g. M8)"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/distanceSpinner"
            android:layout_width="115dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/search_bg"
            android:popupBackground="@drawable/search_bg"
            android:paddingHorizontal="8dp"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <!-- Fragment containers for list and detail map views -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/filterSection">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/listFragmentContainer"
            android:name="org.me.gcu.mcfarlane_daniel_s2521636.view.SituationListFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/detailFragmentContainer"
            android:name="org.me.gcu.mcfarlane_daniel_s2521636.view.DetailMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom navigation bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="2dp"
        app:itemIconTint="@color/traffic_blue"
        app:itemTextColor="@color/traffic_blue"
        app:menu="@menu/bottom_nav_menu" />
</RelativeLayout>