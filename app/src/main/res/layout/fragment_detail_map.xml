<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Text details card containing situation metadata and descriptions -->
    <androidx.cardview.widget.CardView
        android:id="@+id/textCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        app:cardUseCompatPadding="false"
        app:cardPreventCornerOverlap="true"
        app:contentPadding="0dp"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/detailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/closeDetailButton"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:text="Select a situation or plot filtered results"
                        android:textColor="#0D47A1"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/closeDetailButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone"
                        app:tint="#546E7A" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/detailComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tap any item in the list to inspect full XML metadata including impact, validity, direction and coordinates."
                    android:textColor="#263238"
                    android:textSize="13sp" />

                <!-- Discrete Metadata Fields -->
                <LinearLayout
                    android:id="@+id/metadataContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView android:id="@+id/detailImpact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:textColor="#455A64" android:textSize="13sp" />
                    <TextView android:id="@+id/detailOpLanes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:textColor="#455A64" android:textSize="13sp" />
                    <TextView android:id="@+id/detailRestLanes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:textColor="#455A64" android:textSize="13sp" />
                    <TextView android:id="@+id/detailDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:textColor="#455A64" android:textSize="13sp" />
                    <TextView android:id="@+id/detailDirection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:textColor="#455A64" android:textSize="13sp" />
                    <TextView android:id="@+id/detailStartTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:textColor="#455A64" android:textSize="13sp" />
                    <TextView android:id="@+id/detailEndTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:textColor="#455A64" android:textSize="13sp" />
                    <TextView android:id="@+id/detailUrgent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:textColor="#D32F2F" android:textStyle="bold" android:textSize="13sp" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Locations:" android:textStyle="bold" android:textColor="#455A64" android:textSize="13sp" />
                    <TextView android:id="@+id/detailLocations" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#455A64" android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <!-- Map card containing the Google Map view -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mapCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        app:cardUseCompatPadding="false"
        app:cardPreventCornerOverlap="true"
        app:contentPadding="0dp"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp">

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:clipToOutline="true">

            <com.google.android.gms.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Fixed-Size Floating Satellite Pill Switcher in Top-Right -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mapTypeToggleCard"
                android:layout_width="96dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#F2FFFFFF"
                app:cardCornerRadius="17dp"
                app:cardElevation="3dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/mapTypeIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Toggle Map View"
                        android:src="@drawable/ic_map_layers"
                        app:tint="@color/traffic_blue" />

                    <TextView
                        android:id="@+id/mapTypeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Satellite"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>